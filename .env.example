# Copy to ~/.config/bannaha/.env (or ./.env) and fill in only the keys you need.
# Empty values are ignored; variables already set in your shell always win.
# Never commit a filled-in copy.

# Model providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# AWS Bedrock (uses your normal AWS credentials chain)
AWS_PROFILE=
AWS_REGION=

# Optional overrides
# OPENAI_BASE_URL=
# OPENROUTER_BASE_URL=
# BANNAHA_RUNS_DIR=
# BANNAHA_SANDBOX=process
